{
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "ls": "allow",
    "find": "allow",
    "grep": "allow",
    "read": "allow",
    "write": {
      "*": "ask",
      "PLAN.md": "allow",
      "plans/*.md": "allow"
    },
    "edit": {
      "*": "ask",
      "PLAN.md": "allow",
      "plans/*": "allow"
    },
    "plannotator_submit_plan": "allow",
    "submit_result": "allow",
    "coverage_state": "allow",
    "ask_user_question": "allow",
    "fetch_content": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "file *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "pwd *": "allow",
      "git log *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "git status *": "allow",
      "nl *": "allow",
      "sed -n *": "allow",
      "printf *": "allow",
      "true": "allow",
      "kubectl get *": "ask",
      "kubectl describe *": "ask",
      "kubectl log *": "ask",
      "kubectl *": "ask",
      "helm *": "ask",
      "helmfile *": "ask"
    },
    "source_check": "allow",
    "get_search_content": "allow",
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/npm/node_modules/@plannotator/pi-extension/skills/*": "allow",
      "~/.bun/install/global/node_modules/@earendil-works": "allow",
      "~/.bun/install/global/node_modules/@earendil-works/*": "allow"
    },
    "skill": {
      "*": "ask",
      "plannotator*": "allow"
    }
  },
  "auto": {
    "provider": "litellm",
    "model": "amod-gpt-5.6-luna",
    "enabledByDefault": true,
    "timeoutMs": 20000,
    "contextUserTurns": 3,
    "environment": {
      "trustedRoots": [],
      "trustedRemotes": [],
      "trustedDomains": []
    }
  }
}
