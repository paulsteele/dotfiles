{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "authorizerChain": [
    "auto"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "ls": "allow",
    "find": "allow",
    "grep": "allow",
    "read": "allow",
    "write": {
      "*": "ask",
      "PLAN.md": "allow",
      "plans/*.md": "allow"
    },
    "edit": {
      "*": "ask",
      "PLAN.md": "allow",
      "plans/*": "allow"
    },
    "plannotator_submit_plan": "allow",
    "ask_user_question": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "file *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "pwd *": "allow",
      "git log *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "git status *": "allow",
      "nl *": "allow",
      "sed -n *": "allow",
      "printf *": "allow",
      "true": "allow"
    },
    "source_check": "allow",
    "get_search_content": "allow",
    "external_directory": {
      "*": "ask"
    }
  }
}
