/*
# Repo specific
!.gitignore
!.README.md

# Root files
!.zshrc
!.zprofile
!.Xresources
!.tigrc
!.xinitrc
!.xsession
!.vimrc
!.ideavimrc
!.p10k.zsh

# .config directory
!/.config/
/.config/*
!/.config/rofi
!/.config/waybar
!/.config/hypr
!/.config/firefox
!/.config/dunst
!/.config/nvim
!/.config/skhd
!/.config/alacritty
!/.config/sketchybar
/.config/nvim/autoload
/.config/nvim/plugged
/.config/nvim/.netrwhist
/.config/nvim/spell/*.spl
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/claude-notify.sh
!/.claude/statusline-command.sh
!/.config/git
/.config/git/*
!/.config/git/ignore
!/.config/zypper-autoupdates

# Hammerspoon bridge for Pi desktop notifications
!/.hammerspoon/
/.hammerspoon/*
!/.hammerspoon/init.lua
!/.hammerspoon/pi-notify.lua

!/.pi/
/.pi/web-search-cache/*
/.pi/agent/*
!/.pi/agent/settings.json
!/.pi/agent/plannotator.json
# Track custom themes selected by the shared Pi settings.
!/.pi/agent/themes/
/.pi/agent/themes/*
!/.pi/agent/themes/aura.json
# Track reproducible extension dependencies and local Bun patches, but never
# installed dependency contents.
!/.pi/agent/npm/
/.pi/agent/npm/*
!/.pi/agent/npm/package.json
!/.pi/agent/npm/bun.lock
!/.pi/agent/npm/patches/
!/.pi/agent/npm/patches/*.patch
!/.pi/agent/extensions/
/.pi/agent/extensions/*
# Personal Pi extensions live under one tracked, auto-discovered bundle.
!/.pi/agent/extensions/local/
!/.pi/agent/extensions/local/**
!.pi/agent/extensions/pi-permission-system/
/.pi/agent/extensions/pi-permission-system/*
!.pi/agent/extensions/pi-permission-system/config.json

# downloaded spell files
.config/nvim/spell/en.utf-8.sug
