# open terminal
cmd - return : open -na Ghostty --args --working-directory="$HOME"

# Disable Cmd + Q
cmd - q : :

# Quit frontmost app with Cmd + Shift + Q
cmd + shift - q : osascript -e 'tell application (path to frontmost application as text) to quit'

# Lock screen with Cmd + L
cmd - l : pmset displaysleepnow
