font-family = MesloLGL Nerd Font
font-size = 20
background-opacity = 0.9
quit-after-last-window-closed = true

scrollback-limit = 10000000

keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+0=reset_font_size

background = #15141b
foreground = #edecee
cursor-color = #a277ff
selection-background = #29263c
selection-foreground = cell-foreground

palette = 0=#110f18
palette = 1=#ff6767
palette = 2=#61ffca
palette = 3=#ffca85
palette = 4=#a277ff
palette = 5=#a277ff
palette = 6=#61ffca
palette = 7=#edecee
palette = 8=#4d4d4d
palette = 9=#ff6767
palette = 10=#61ffca
palette = 11=#ffca85
palette = 12=#a277ff
palette = 13=#a277ff
palette = 14=#61ffca
palette = 15=#edecee
